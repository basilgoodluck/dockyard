generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServerStatus {
  CONNECTED
  UNREACHABLE
  INSTALLING
  UNKNOWN
}

model User {
  id        String   @id           // Discord snowflake
  createdAt DateTime @default(now())
  servers   Server[]
}

model Server {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id])

  name      String
  host      String
  sshPort   Int    @default(22)
  sshUser   String

  agentPort    Int          @default(3000)
  agentSecret  String       // AES-256-GCM encrypted
  agentVersion String?      // populated after first health check

  sshPrivateKey String?     // encrypted, nullable post-install
  sshPassword   String?     // encrypted, nullable post-install

  status    ServerStatus @default(UNKNOWN)
  lastSeen  DateTime?
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stacks      Stack[]
  commandLogs CommandLog[]

  @@unique([userId, host])
  @@unique([userId, name])
  @@index([userId])
}

model Stack {
  id       String @id @default(cuid())
  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  name          String
  path          String    // absolute path on VPS
  lastStatus    String?   // "running" | "stopped" | "partial"
  lastCheckedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([serverId, name])
  @@index([serverId])
}

model CommandLog {
  id       String @id @default(cuid())
  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  userId   String
  command  String
  args     Json
  output   String?  @db.Text
  success  Boolean
  duration Int      // milliseconds

  createdAt DateTime @default(now())

  @@index([serverId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}