---
import Base from '../layouts/Base.astro';
---
<Base title="Dockyard">
  <main class="min-h-screen w-full bg-yellow-400 flex flex-col justify-center items-start px-8">
    <div class="max-w-3xl mx-auto w-full">
      <pre class="font-mono text-neutral-950 text-sm mb-6">$ dockyard ps --all</pre>

      <h1 class="font-mono font-semibold text-neutral-950 text-4xl md:text-5xl leading-tight mb-5">
        Manage every Docker box you SSH into.<br />From one terminal.
      </h1>

      <p class="text-neutral-800 text-lg max-w-md mb-8">
        No agent. No dashboard. No server-side anything. Just your existing SSH keys.
      </p>

      <div class="install-box mb-6">
        <code class="font-mono text-yellow-400 text-sm install-text">
          <span class="typewriter">curl -sSL https://dockyard.sh/install | sh</span>
        </code>
        <button class="copy-btn" id="copyBtn" data-command="curl -sSL https://dockyard.sh/install | sh">Copy</button>
      </div>

      <div>
        <a href="https://github.com/basilgoodluck/dockyard" class="github-btn font-mono font-semibold text-yellow-400 text-sm">View on GitHub →</a>
      </div>
    </div>
  </main>
</Base>

<script>
  const btn = document.getElementById('copyBtn');

  btn?.addEventListener('click', async () => {
    const command = btn.getAttribute('data-command') || '';
    await navigator.clipboard.writeText(command);
    btn.textContent = 'Copied';
    setTimeout(() => {
      btn.textContent = 'Copy';
    }, 1500);
  });
</script>

<style>
  .install-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 420px;
    max-width: 100%;
    background: #0a0a0a;
    padding: 0.9rem 1.4rem;
    border-radius: 0.6rem;
    box-shadow:
      inset 0 4px 8px rgba(0, 0, 0, 0.7),
      inset 0 -3px 6px rgba(255, 255, 255, 0.06),
      inset 3px 0 6px rgba(0, 0, 0, 0.5),
      inset -3px 0 6px rgba(0, 0, 0, 0.5);
  }

  .install-text {
    flex: 1;
    overflow: hidden;
  }

  .copy-btn {
    flex-shrink: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    background: transparent;
    border: 1px solid #404040;
    border-radius: 0.4rem;
    color: #a3a3a3;
    padding: 0.4rem 0.7rem;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .copy-btn:hover {
    color: #f5c518;
    border-color: #f5c518;
  }

  .typewriter {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    border-right: 2px solid #f5c518;
    width: 0;
    animation:
      typing 4s steps(38, end) infinite,
      blink 0.75s step-end infinite;
  }

  @keyframes typing {
    0%, 5% { width: 0; }
    40%, 60% { width: 38ch; }
    95%, 100% { width: 0; }
  }

  @keyframes blink {
    50% { border-color: transparent; }
  }

  .github-btn {
    display: inline-block;
    background: radial-gradient(
      circle at 50% 25%,
      #3a3a3a 0%,
      #1a1a1a 45%,
      #0a0a0a 100%
    );
    padding: 0.9rem 1.8rem;
    border: 2px solid #262626;
    border-radius: 0.6rem;
    text-decoration: none;
    box-shadow:
      inset 0 3px 4px rgba(255, 255, 255, 0.2),
      inset 0 -8px 12px rgba(0, 0, 0, 0.6),
      0 12px 24px rgba(0, 0, 0, 0.4);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .github-btn:hover {
    transform: translateY(-3px);
    box-shadow:
      inset 0 3px 4px rgba(255, 255, 255, 0.2),
      inset 0 -8px 12px rgba(0, 0, 0, 0.6),
      0 16px 28px rgba(0, 0, 0, 0.45);
  }

  .github-btn:active {
    transform: translateY(2px);
    box-shadow:
      inset 0 5px 10px rgba(0, 0, 0, 0.6),
      inset 0 -2px 4px rgba(255, 255, 255, 0.1),
      0 4px 10px rgba(0, 0, 0, 0.3);
  }
</style>