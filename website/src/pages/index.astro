---
import Base from '../layouts/Base.astro';
---
<Base title="Dockyard">
  <main class="min-h-screen w-full bg-yellow-400 flex flex-col justify-center items-start px-8">
    <div class="max-w-3xl mx-auto w-full">
      <pre class="font-mono text-neutral-950 text-sm mb-6">$ dockyard ps --all</pre>

      <h1 class="font-mono font-semibold text-neutral-950 text-4xl md:text-5xl leading-tight mb-5">
        Manage every Docker box you SSH into.<br />From one terminal.
      </h1>

      <p class="text-neutral-800 text-lg max-w-md mb-8">
        No agent. No dashboard. No server-side anything. Just your existing SSH keys.
      </p>

      <div class="install-box mb-8">
        <code class="font-mono text-yellow-400 text-sm typewriter">curl -sSL https://dockyard.sh/install | sh</code>
      </div>

      <a href="https://dockyard.sh" class="github-btn font-mono font-semibold text-yellow-400 text-sm">View on GitHub →</a>
    </div>
  </main>
</Base>

<style>
  .install-box {
    display: inline-block;
    background: #0a0a0a;
    padding: 0.9rem 1.4rem;
    border-radius: 0.6rem;
    box-shadow:
      inset 0 3px 6px rgba(0, 0, 0, 0.6),
      inset 0 -2px 4px rgba(255, 255, 255, 0.05);
  }

  .github-btn {
    display: inline-block;
    background: radial-gradient(
      circle at 50% 25%,
      #262626 0%,
      #171717 40%,
      #0a0a0a 100%
    );
    padding: 0.9rem 1.6rem;
    border: 2px solid #171717;
    border-radius: 0.6rem;
    text-decoration: none;
    box-shadow:
      inset 0 2px 3px rgba(255, 255, 255, 0.15),
      inset 0 -6px 10px rgba(0, 0, 0, 0.5),
      0 8px 18px rgba(0, 0, 0, 0.3);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .github-btn:hover {
    transform: translateY(-2px);
  }

  .github-btn:active {
    transform: translateY(2px);
    box-shadow:
      inset 0 4px 8px rgba(0, 0, 0, 0.5),
      inset 0 -2px 4px rgba(255, 255, 255, 0.1),
      0 4px 10px rgba(0, 0, 0, 0.25);
  }

  .typewriter {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    border-right: 2px solid #f5c518;
    width: 0;
    animation:
      typing 2.5s steps(38, end) forwards,
      blink 0.75s step-end infinite;
  }

  @keyframes typing {
    from { width: 0; }
    to { width: 38ch; }
  }

  @keyframes blink {
    50% { border-color: transparent; }
  }
</style>